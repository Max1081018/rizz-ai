<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_card"
    android:padding="16dp"
    android:elevation="16dp">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Rizz AI Wingman"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnHudScan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Scan"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHudClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close HUD"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/text_muted" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Loading state indicator -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/overlay_analyzing"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Psychological insight box -->
    <LinearLayout
        android:id="@+id/layoutPsychology"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_vibe_badge"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtVibeHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PSYCHOLOGICAL READ"
            android:textColor="@color/hud_vibe_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/txtPsychologyInsight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Scan a chat to detect subtext, frame, and vibe..."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Suggestions Container -->
    <LinearLayout
        android:id="@+id/layoutSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Suggestion 1: Smooth / Flirty -->
        <LinearLayout
            android:id="@+id/btnReply1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_suggestion_pill"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lblReply1Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 SMOOTH / FLIRTY"
                android:textColor="@color/pill_category_flirty"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtReply1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap 'Scan' to generate calibrated lines"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Suggestion 2: Playful Tease -->
        <LinearLayout
            android:id="@+id/btnReply2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_suggestion_pill"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lblReply2Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😏 PLAYFUL TEASE"
                android:textColor="@color/pill_category_tease"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtReply2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Matches banter and humor dynamics"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Suggestion 3: High-EQ Closer -->
        <LinearLayout
            android:id="@+id/btnReply3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_suggestion_pill"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lblReply3Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 HIGH-EQ CLOSER"
                android:textColor="@color/pill_category_closer"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtReply3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Moves the conversation forward naturally"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Footer guide -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/overlay_tap_to_copy"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
